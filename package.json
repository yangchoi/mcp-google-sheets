{
  "name": "@yangchoi/mcp-google-sheets",
  "version": "0.1.0",
  "description": "A Model Context Protocol (MCP) server for Google Sheets \u2014 read, write, and manage spreadsheets from Claude Desktop, Claude Code, or any MCP-compatible AI client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-sheets",
    "sheets",
    "spreadsheet",
    "claude",
    "claude-desktop",
    "claude-code",
    "anthropic",
    "ai",
    "llm",
    "ai-agent",
    "agent-tool",
    "automation",
    "google-workspace",
    "oauth",
    "typescript"
  ],
  "author": "yangchoi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangchoi/mcp-google-sheets.git"
  },
  "bugs": {
    "url": "https://github.com/yangchoi/mcp-google-sheets/issues"
  },
  "homepage": "https://github.com/yangchoi/mcp-google-sheets#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-google-sheets": "dist/index.js",
    "mcp-google-sheets-auth": "dist/auth-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:offline": "npm run build && node --test test/cli.test.mjs test/errors.test.mjs",
    "check-auth": "node dist/check-auth.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "googleapis": "^144.0.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
