# Optional overrides. All defaults resolve under ~/.config/mcp-google-sheets/
# Uncomment and set only if you want the credentials / token stored elsewhere.

# GOOGLE_SHEETS_CREDENTIALS_PATH=/absolute/path/to/credentials.json
# GOOGLE_SHEETS_TOKEN_PATH=/absolute/path/to/token.json
# MCP_GOOGLE_SHEETS_CONFIG_DIR=/absolute/path/to/config-dir
